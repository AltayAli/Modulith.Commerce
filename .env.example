# Local dev only. Values below match the client secrets baked into
# keycloak/import/modulith-commerce-realm.json (auto-imported on first boot),
# so `docker compose up` works out of the box. Change them if you edit that realm file.
SA_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_WEB_CLIENT_SECRET=
