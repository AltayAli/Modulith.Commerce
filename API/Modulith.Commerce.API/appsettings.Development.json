{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "CacheConnection": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "http://localhost:8082/realms/modulith-commerce",
    "ValidIssuer": "http://localhost:8082/realms/modulith-commerce",
    "Audience": "modulith-commerce-api",
    "BaseUrl": "http://localhost:8082",
    "Realm": "modulith-commerce",
    "AdminClientId": "modulith-commerce-admin-client",
    "AdminClientSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
