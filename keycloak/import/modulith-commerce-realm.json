{
  "realm": "modulith-commerce",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "modulith-commerce-web",
      "name": "Modulith Commerce Web (End-User Login)",
      "description": "Confidential BFF client for interactive end-user login (Authorization Code + PKCE). Not used for AdminUser provisioning - see modulith-commerce-admin-client for that.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "c659dba316159fa6536a3f1af4ea7bf2bec654c9",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5000/auth/callback",
        "http://localhost:5000/auth/signout-callback"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins"
