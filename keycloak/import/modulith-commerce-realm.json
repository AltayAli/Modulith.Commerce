        "post.logout.redirect.uris": "http://localhost:5000/auth/signout-callback##http://localhost:5000/"
      }
    },
    {
      "clientId": "modulith-commerce-admin-client",
      "name": "Modulith Commerce Admin API Client",
      "description": "Service-account client used server-side (KeycloakClient) to provision/sync AdminUser accounts and roles via the Keycloak Admin REST API. Not used for interactive login.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "c891d669d78611a1bb1298e38283acf72b3ab9fd",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-modulith-commerce-admin-client",
      "enabled": true,
      "serviceAccountClientId": "modulith-commerce-admin-client",
      "clientRoles": {
        "realm-management": ["realm-admin"]
